
import java.util.*;

class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {

        int n = nums.length;
        int LOG = 18;

        int[][] jump = new int[LOG][n];
        long[][] sum = new long[LOG][n];

        int[] stack = new int[n];
        int top = -1;

        // Find next greater element
        for (int i = n - 1; i >= 0; i--) {

            while (top >= 0 && nums[stack[top]] <= nums[i]) {
                top--;
            }

            jump[0][i] = (top == -1) ? n : stack[top];

            sum[0][i] = (long) nums[i] * (jump[0][i] - i);

            stack[++top] = i;
        }

        // Build binary lifting table
        for (int j = 1; j < LOG; j++) {

            for (int i = 0; i < n; i++) {

                int mid = jump[j - 1][i];

                if (mid < n) {
                    jump[j][i] = jump[j - 1][mid];
                    sum[j][i] = sum[j - 1][i] + sum[j - 1][mid];
                } else {
                    jump[j][i] = n;
                    sum[j][i] = sum[j - 1][i];
                }
            }
        }

        // Calculate prefix sums
        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        long ans = 0;

        // Binary search for every starting index
        for (int l = 0; l < n; l++) {

            int low = l;
            int high = n - 1;
            int best = l - 1;

            while (low <= high) {

                int mid = low + (high - low) / 2;

                int cur = l;
                long total = 0;

                // Calculate sum of prefix maximums
                for (int j = LOG - 1; j >= 0; j--) {

                    int next = jump[j][cur];

                    if (next <= mid) {
                        total += sum[j][cur];
                        cur = next;
                    }
                }

                total += (long) nums[cur] * (mid - cur + 1);

                long operations = total -
                    (prefix[mid + 1] - prefix[l]);

                if (operations <= k) {
                    best = mid;
                    low = mid + 1;
                } else {
                    high = mid - 1;
                }
            }

            ans += best - l + 1;
        }

        return ans;
    }
}

